    run:
        #mean_dp_dic = read_dp(input.cov)
        with open(input.cov) as f:
            mean_dp_dic = yaml.safe_load(f) 
                # calculate dictionaries for min/max coverage per sample based on Poisson dist and pvals defined under params (in config)
