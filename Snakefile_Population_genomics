#===== window-based tree (iqtree + astral) =====
    # Creates a windowed tree. Here a tree is created for every 100KB in the genome, this is then put into ASTRAL to create the consensus tree (cf. Henrique)

rule calculate_trees_windows: 
    input:
        vcf = vcf_outgroup
    output:
        tree = f"{results_dir}/population_analyses/rPodSic1.hap1.1/tree/{window_size_kb}KB_v2/{callset_id}_{{window}}.treefile"
        #expand(f"{results_dir}/population_analyses/rPodSic1.hap1.1/tree/{window_size_kb}KB/{callset_id}_{{window}}.treefile", window = windows)
    params:
        script = config["scripts"]["vcf2phylip"],
        threads = "AUTO",
        bootstraps = "1000",
        model = "GTR",
        outgroup = 'PMU01', 
        #window = lambda wildcards: wildcards.window,
        #prefix = f"{results_dir}/population_analyses/tree/{window_size_kb}KB/{callset_id}_{{window}}"
    resources:
        mem_mb=3840,
        cpus=1,
        walltime=12
    wildcard_constraints:
        window = "|".join(windows)
    shell: 
        """
        bcftools view -r {wildcards.window} {input.vcf} > {wildcards.window}.vcf 
        python {params.script} -i {wildcards.window}.vcf 
        iqtree -s {wildcards.window}.min4.phy -nt {params.threads} -B {params.bootstraps} -m {params.model} -o {params.outgroup} --prefix f"{results_dir}/population_analyses/tree/{window_size_kb}KB/{callset_id}_{{window}}" --redo-tree
        rm {wildcards.window}.vcf {wildcards.window}.min4.phy
        """          
