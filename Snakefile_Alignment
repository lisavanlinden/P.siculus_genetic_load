# def for fastq rule

def get_fq(some_id, read = 12):
    fq = "{dir}/{reads}".format(dir = sequence_mt["path"].loc[some_id], reads = sequence_mt["read_files"].loc[some_id])
    fq1 = fq.format("1")
    fq2 = fq.format("2")
    if read == 1:
        return [fq1]
    elif read == 2:
        return [fq2]
    elif read == 12:
        return [fq1, fq2]

